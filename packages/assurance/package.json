    "q0": "tsx scripts/q0.ts",
    "q1": "tsx scripts/q1.ts",
    "q2": "NODE_ENV=test tsx scripts/q2.ts",
    "q3": "NODE_ENV=test tsx scripts/q3.ts",
    "m6": "NODE_ENV=test tsx scripts/m6.ts",
    "m4": "NODE_ENV=test tsx scripts/m4.ts",
    "experiment:engineering-lab:seeded": "tsx scripts/engineering-lab-seeded.ts",
    "campaign:praxis": "tsx scripts/campaigns/praxis-production-campaign.ts",
    "campaign:praxis:100": "tsx scripts/campaigns/praxis-production-campaign-100.ts",
    "campaign:praxis:resilience": "tsx scripts/campaigns/praxis-resilience-campaign.ts",
    "campaign:praxis:public-apps": "tsx scripts/campaigns/praxis-public-app-campaign.ts",
    "campaign:veil:adversarial": "tsx scripts/campaigns/veil-adversarial-campaign.ts",
    "campaign:veil:public-apps": "tsx scripts/campaigns/veil-public-app-campaign.ts",
    "campaign:veil:performance": "tsx scripts/campaigns/veil-performance-campaign.ts",
    "campaign:veil:release-scope": "tsx scripts/campaigns/veil-release-scope-campaign.ts",
    "campaign:praxis:qualification": "tsx scripts/campaigns/praxis-qualification-campaign.ts",
    "campaign:veil:qualification": "tsx scripts/campaigns/veil-qualification-campaign.ts",
    "experiment:synthesis:seeded": "tsx scripts/experiment-cluster-seeded.ts"
  },
  "dependencies": {
