{
  "name": "@scry/executor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "scry": "./src/cli.ts"
  },
  "scripts": {
    "campaign:praxis": "tsx scripts/praxis-production-campaign.ts",
    "campaign:praxis:100": "tsx scripts/praxis-production-campaign-100.ts",
    "campaign:praxis:resilience": "tsx scripts/praxis-resilience-campaign.ts",
    "campaign:praxis:certification": "tsx scripts/praxis-certification-campaign.ts",
    "campaign:praxis:public-apps": "tsx scripts/praxis-public-app-campaign.ts",
    "campaign:veil:certification": "tsx scripts/veil-certification-campaign.ts",
    "campaign:veil:adversarial": "tsx scripts/veil-adversarial-campaign.ts",
    "campaign:veil:public-apps": "tsx scripts/veil-public-app-campaign.ts",
    "campaign:veil:performance": "tsx scripts/veil-performance-campaign.ts",
    "campaign:veil:production-e2e": "tsx scripts/veil-production-e2e-campaign.ts",
    "campaign:veil:release-scope": "tsx scripts/veil-release-scope-campaign.ts",
    "cli": "tsx src/cli.ts",
    "test": "SCRY_BROWSER_CHANNEL=chrome vitest run --maxWorkers=4",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@scry/artifact": "workspace:*",
    "@scry/contracts": "workspace:*",
    "@scry/policy": "workspace:*",
    "@tesseract.js-data/eng": "^1.0.0",
    "fflate": "^0.8.3",
    "playwright": "1.62.0",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vitest": "^4.0.15"
  }
}
