# staging and beta run the core application without operational services by default.
# Set production only when the mandatory operations configuration below is complete.
SCRY_DEPLOYMENT_TIER=staging
COMPOSE_PROFILES=

# Application images must be immutable digests in production.
SCRY_IMAGE_REF=registry.example/scry@sha256:replace
SCRY_BACKUP_IMAGE_REF=
SCRY_DOMAIN=scry.example.com
SCRY_RELEASE_ID=replace
SCRY_DATABASE_NAME=replace-with-existing-database-name

POSTGRES_PASSWORD=replace
SUPABASE_URL=https://replace.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace
SCRY_SERVICE_TOKEN=replace
SCRY_BROWSER_PROTECTED_KEY_ID=browser-key-1
# Database-wide live browser reservation limit, not queue-job concurrency.
# Keep API/worker replicas consistent. Raise only after measuring available memory.
SCRY_BROWSER_MAX_LIVE_SESSIONS=1
# JSON object mapping every readable key ID to a distinct 32-byte base64 key.
# Keep retired key IDs here until no retained protected value uses them.
SCRY_BROWSER_PROTECTED_KEYS_JSON={"browser-key-1":"replace-with-32-byte-base64-key"}

# Optional operations profile. To enable, set COMPOSE_PROFILES=operations,
# POSTGRES_ARCHIVE_MODE=on, an immutable backup image, repository credentials,
# and an alert webhook. These become mandatory for SCRY_DEPLOYMENT_TIER=production.
POSTGRES_ARCHIVE_MODE=off
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_AWS_REGION=us-east-1
BACKUP_AWS_ENDPOINT=https://object.example.com

# Defaults enforce database RPO <= 5 minutes, artifact RPO <= 15 minutes,
# restore RTO <= 60 minutes, and weekly restore drills.
POSTGRES_WAL_BACKUP_INTERVAL_SECONDS=300
POSTGRES_BASE_BACKUP_INTERVAL_SECONDS=86400
ARTIFACT_BACKUP_INTERVAL_SECONDS=900
RESTORE_DRILL_INTERVAL_SECONDS=604800
RESTORE_DRILL_RTO_SECONDS=3600

# local | s3 | cloudinary | gcs
ARTIFACT_STORAGE_PROVIDER=local
ARTIFACT_STORE_VERSIONING_CONFIRMED=false
ARTIFACT_RETENTION_MS=2592000000

# Privacy-safe operational telemetry retention and alerting (30 days, hourly bounded pruning).
SCRY_OPERATIONAL_EVENT_RETENTION_DAYS=30
SCRY_OPERATIONAL_EVENT_RETENTION_BATCH_SIZE=1000
SCRY_OPERATIONAL_EVENT_RETENTION_INTERVAL_MS=3600000
SCRY_RECONCILIATION_ALERT_MS=300000

SCRY_ALERT_WEBHOOK_URL=
