{
  "contractSource": "public Partner API OpenAPI",
  "operations": [
    {
      "operation": "List Orders",
      "method": "GET",
      "routeClass": "/api/v1/partner-api/orders",
      "requiredInputs": ["partner_api_client_id", "partner_api_client_secret"],
      "optionalInputs": ["page", "limit", "status"],
      "queryConstraints": { "page": "integer>=1", "limit": "integer:1..100", "status": "documented_enum" },
      "filtering": "status",
      "sorting": "NOT_DOCUMENTED",
      "responseClass": "order_collection",
      "classification": "read_only"
    },
    {
      "operation": "Retrieve Order",
      "method": "GET",
      "routeClass": "/api/v1/partner-api/orders/{opaque-order-identity}",
      "requiredInputs": ["partner_api_client_id", "partner_api_client_secret", "canonical_order_identity"],
      "canonicalIdentityLocation": "response.data.id",
      "responseClass": "canonical_order",
      "classification": "read_only"
    },
    {
      "operation": "Create Order",
      "method": "POST",
      "routeClass": "/api/v1/partner-api/orders",
      "requiredInputs": ["partner_api_client_id", "partner_api_client_secret", "provider_idempotency_key", "orderType", "orderedFor", "quantity", "kitType", "currency", "shipping"],
      "optionalInputs": ["deliveryMode"],
      "identityAlternatives": ["clientId", "nested_client", "practitionerId", "nested_practitioner"],
      "identityRule": "exactly_one_matching_orderedFor",
      "canonicalIdentityLocation": "response.data.id",
      "responseClass": "canonical_created_order",
      "classification": "one_time_mutation"
    }
  ],
  "safeClassifications": [
    "VALIDATION_REJECTED",
    "AUTHENTICATION_REJECTED",
    "AUTHORIZATION_REJECTED",
    "NOT_FOUND",
    "CONFLICTING_IDENTITY",
    "IDEMPOTENCY_CONFLICT",
    "AMBIGUOUS_IDENTITY",
    "REQUEST_NOT_INITIATED",
    "PROVIDER_NON_SUCCESS",
    "RECOVERY_REQUIRED"
  ],
  "evidencePolicy": {
    "credentials": "excluded",
    "protectedValues": "excluded",
    "canonicalIdentities": "excluded",
    "requestBodies": "excluded",
    "syntheticPii": "excluded"
  },
  "environmentQualification": {
    "test": "exact_authoritative_environment_with_scoped_protected_synthetic_capability",
    "live": "authoritative_environment_not_configured",
    "liveReadOnly": "NOT_PERMITTED_BY_POLICY",
    "liveMutation": "refused_before_provider",
    "liveProviderMutationCount": 0
  }
}
