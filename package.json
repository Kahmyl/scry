{
  "name": "scry",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "db:migrate": "pnpm --filter @scry/api db:migrate",
    "qualify:live": "pnpm --filter @scry/api qualify:live",
    "dev:api": "pnpm --filter @scry/api dev",
    "docker:up": "pnpm verify:release-fingerprint && docker compose up --build --wait",
    "docker:dev": "docker compose up --build --watch",
    "docker:watch": "docker compose watch --no-up",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f --tail=200",
    "docker:reset": "docker compose down --volumes --remove-orphans",
    "scry": "pnpm --filter @scry/executor cli",
    "verify:privacy-foundation": "node scripts/verify-privacy-foundation.mjs",
    "verify:playwright": "node scripts/verify-playwright-version.mjs",
    "verify:agent-skills": "node scripts/verify-agent-skills.mjs",
    "verify:subsystem-boundaries": "node scripts/verify-subsystem-boundaries.mjs",
    "verify:repository-topology": "node scripts/verify-repository-topology.mjs",
    "baseline:authoring": "node scripts/authoring-baseline.mjs",
    "verify:adaptive-authoring-release": "node scripts/verify-adaptive-authoring-release.mjs",
    "verify:execution-kernel-boundary": "node scripts/verify-execution-kernel-boundary.mjs",
    "verify:direct-browser-boundary": "node scripts/verify-direct-browser-boundary.mjs",
    "verify:protected-interaction-conformance": "pnpm --filter @scry/api exec vitest run test/protected-interaction-conformance.test.ts test/mission-authoring-protected-replay-portability.test.ts && pnpm --filter @scry/praxis exec vitest run test/protected-scope-conformance.test.ts",
    "verify:dashboard-read-only": "pnpm --filter @scry/web build && node scripts/verify-dashboard-read-only.mjs",
    "schema:fingerprint": "node scripts/schema-fingerprint.mjs",
    "verify:release-fingerprint": "node scripts/verify-release-fingerprint.mjs",
    "verify:production-operations": "node scripts/verify-production-operations.mjs",
    "verify:deployment-preflight": "node scripts/verify-deployment-preflight.mjs",
    "verify:deployment-tiers": "node scripts/verify-deployment-tiers.mjs",
    "verify:production-recovery": "sh scripts/qualify-production-recovery.sh",
    "verify:docker-publish-workflow": "node scripts/verify-docker-publish-workflow.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "analyze:decomposition": "node scripts/analyze-source-structure.mjs",
    "test": "pnpm --recursive test",
    "test:beta": "node scripts/run-beta-tests.mjs",
    "typecheck": "pnpm --recursive typecheck",
    "verify:assurance": "pnpm --filter @scry/assurance typecheck && pnpm --filter @scry/assurance test:truth",
    "verify": "node scripts/verification-driver.mjs",
    "verify:audit": "node scripts/verification-driver.mjs --audit",
    "verify:full": "node scripts/verification-driver.mjs --full"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "vitest": "^4.0.15"
  }
}
