{
  "name": "scry",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "db:migrate": "pnpm --filter @scry/api db:migrate",
    "dev:api": "pnpm --filter @scry/api dev",
    "docker:up": "pnpm verify:release-fingerprint && docker compose up --build --wait",
    "docker:dev": "docker compose up --build --watch",
    "docker:watch": "docker compose watch --no-up",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f --tail=200",
    "docker:reset": "docker compose down --volumes --remove-orphans",
    "scry": "pnpm --filter @scry/executor cli",
    "verify:privacy-foundation": "node scripts/verify-privacy-foundation.mjs",
    "verify:playwright": "node scripts/verify-playwright-version.mjs",
    "verify:agent-skills": "node scripts/verify-agent-skills.mjs",
    "verify:praxis-inventory": "node scripts/verify-praxis-interaction-inventory.mjs",
    "verify:praxis-change-gate": "node scripts/verify-praxis-change-gate.mjs",
    "baseline:praxis": "node scripts/praxis-baseline.mjs",
    "campaign:praxis": "pnpm --filter @scry/executor campaign:praxis",
    "campaign:praxis:100": "pnpm --filter @scry/executor campaign:praxis:100",
    "campaign:praxis:resilience": "pnpm --filter @scry/executor campaign:praxis:resilience",
    "campaign:praxis:certification": "pnpm --filter @scry/executor campaign:praxis:certification",
    "campaign:praxis:public-apps": "pnpm --filter @scry/executor campaign:praxis:public-apps",
    "verify:praxis-performance": "node scripts/verify-praxis-performance.mjs",
    "campaign:veil:certification": "pnpm --filter @scry/executor campaign:veil:certification",
    "campaign:veil:adversarial": "pnpm --filter @scry/executor campaign:veil:adversarial",
    "campaign:veil:public-apps": "pnpm --filter @scry/executor campaign:veil:public-apps",
    "campaign:veil:production-e2e": "pnpm --filter @scry/executor campaign:veil:production-e2e",
    "campaign:veil:release-scope": "pnpm --filter @scry/executor campaign:veil:release-scope",
    "campaign:veil:worker-crash": "pnpm --filter @scry/api campaign:veil:worker-crash",
    "verify:veil-change-gate": "node scripts/verify-veil-change-gate.mjs",
    "verify:veil-performance": "node scripts/verify-veil-performance.mjs",
    "verify:dashboard-read-only": "pnpm --filter @scry/web build && node scripts/verify-dashboard-read-only.mjs",
    "schema:fingerprint": "node scripts/schema-fingerprint.mjs",
    "verify:release-fingerprint": "node scripts/verify-release-fingerprint.mjs",
    "verify:veil-release-transition": "node scripts/verify-veil-release-transition.mjs",
    "verify:veil-db-restore": "bash scripts/veil-db-snapshot-restore.sh",
    "verify:veil-rollback:docker": "bash scripts/qualify-veil-cross-schema-rollback.sh",
    "test": "pnpm --recursive test",
    "typecheck": "pnpm --recursive typecheck"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.3",
    "vitest": "^4.0.15"
  }
}
