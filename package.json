{
  "name": "scry",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "db:migrate": "pnpm --filter @scry/api db:migrate",
    "dev:api": "pnpm --filter @scry/api dev",
    "docker:up": "pnpm verify:release-fingerprint && docker compose up --build --wait",
    "docker:dev": "docker compose up --build --watch",
    "docker:watch": "docker compose watch --no-up",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f --tail=200",
    "docker:reset": "docker compose down --volumes --remove-orphans",
    "scry": "pnpm --filter @scry/executor cli",
    "verify:privacy-foundation": "node scripts/verify-privacy-foundation.mjs",
    "verify:playwright": "node scripts/verify-playwright-version.mjs",
    "verify:agent-skills": "node scripts/verify-agent-skills.mjs",
    "verify:subsystem-boundaries": "node scripts/verify-subsystem-boundaries.mjs",
    "verify:repository-topology": "node scripts/verify-repository-topology.mjs",
    "verify:praxis-inventory": "node scripts/verify-praxis-interaction-inventory.mjs",
    "verify:praxis-change-gate": "node scripts/verify-praxis-change-gate.mjs",
    "baseline:praxis": "node scripts/praxis-baseline.mjs",
    "baseline:authoring": "node scripts/authoring-baseline.mjs",
    "verify:adaptive-authoring-release": "node scripts/verify-adaptive-authoring-release.mjs",
    "verify:execution-kernel-boundary": "node scripts/verify-execution-kernel-boundary.mjs",
    "verify:direct-browser-boundary": "node scripts/verify-direct-browser-boundary.mjs",
    "verify:mission-first:m1:ownership": "node scripts/verify-direct-browser-boundary.mjs",
    "campaign:adaptive:m0:core": "pnpm --filter @scry/api exec tsx scripts/adaptive-core-campaign-m0.ts",
    "campaign:adaptive:m0:vitract": "pnpm --filter @scry/api exec tsx scripts/adaptive-vitract-campaign.ts M0",
    "verify:adaptive:m0": "pnpm --filter @scry/assurance test && pnpm --filter @scry/api exec tsx scripts/verify-adaptive-milestone.ts M0",
    "campaign:adaptive:m1:core": "pnpm --filter @scry/api exec tsx scripts/adaptive-core-campaign-m1.ts",
    "campaign:adaptive:m1:vitract": "pnpm --filter @scry/api exec tsx scripts/adaptive-vitract-campaign.ts M1",
    "verify:adaptive:m1": "pnpm verify:execution-kernel-boundary && pnpm --filter @scry/api exec tsx scripts/verify-adaptive-milestone.ts M1",
    "campaign:mission-first:m1:core": "pnpm --filter @scry/api exec tsx scripts/adaptive-core-campaign-m1.ts",
    "campaign:mission-first:m1:vitract": "pnpm --filter @scry/api exec tsx scripts/adaptive-vitract-campaign.ts M1",
    "campaign:mission-first:m1:external": "pnpm --filter @scry/api exec tsx scripts/mission-live-m1-external.ts",
    "verify:mission-first:m1": "pnpm verify:mission-first:m1:ownership && pnpm verify:execution-kernel-boundary && pnpm --filter @scry/api exec tsx scripts/verify-mission-first-milestone.ts M1",
    "verify:mission-first:m2:boundary": "node scripts/verify-m2-authoring-boundary.mjs",
    "campaign:mission-first:m2:core": "pnpm --filter @scry/api exec tsx scripts/mission-live-m2-core.ts",
    "campaign:mission-first:protected-qualification": "pnpm --filter @scry/api exec tsx scripts/mission-protected-qualification.ts",
    "certification:protected-transactions": "pnpm --filter @scry/api exec tsx scripts/protected-transaction-certification.ts",
    "campaign:mission-first:protected-fixture": "pnpm --filter @scry/api exec tsx scripts/mission-protected-qualification-host.ts",
    "campaign:mission-first:m2:vitract": "pnpm --filter @scry/api exec tsx scripts/mission-live-m2-vitract.ts",
    "campaign:mission-first:m2:external": "pnpm --filter @scry/api exec tsx scripts/mission-live-m2-external.ts",
    "verify:mission-first:m2": "pnpm verify:mission-first:m2:boundary && pnpm verify:execution-kernel-boundary && pnpm --filter @scry/api exec tsx scripts/verify-mission-first-m2.ts",
    "verify:m1:preflight": "node scripts/verify-m1-preflight.mjs",
    "campaign:adaptive:m2:core": "pnpm --filter @scry/api exec tsx scripts/adaptive-core-campaign.ts M2",
    "verify:adaptive:m2": "pnpm --filter @scry/api exec tsx scripts/verify-adaptive-milestone.ts M2",
    "campaign:adaptive:m3:core": "pnpm --filter @scry/api exec tsx scripts/adaptive-core-campaign.ts M3",
    "verify:adaptive:m3": "pnpm --filter @scry/api exec tsx scripts/verify-adaptive-milestone.ts M3",
    "campaign:adaptive:m4:core": "pnpm --filter @scry/api exec tsx scripts/adaptive-core-campaign.ts M4",
    "verify:adaptive:m4": "pnpm --filter @scry/api exec tsx scripts/verify-adaptive-milestone.ts M4",
    "campaign:adaptive:m5:core": "pnpm --filter @scry/api exec tsx scripts/adaptive-core-campaign.ts M5",
    "verify:adaptive:m5": "pnpm --filter @scry/api exec tsx scripts/verify-adaptive-milestone.ts M5",
    "campaign:praxis": "pnpm --filter @scry/executor campaign:praxis",
    "campaign:praxis:100": "pnpm --filter @scry/executor campaign:praxis:100",
    "campaign:praxis:resilience": "pnpm --filter @scry/executor campaign:praxis:resilience",
    "campaign:praxis:certification": "pnpm --filter @scry/executor campaign:praxis:certification",
    "campaign:praxis:public-apps": "pnpm --filter @scry/executor campaign:praxis:public-apps",
    "verify:praxis-performance": "node scripts/verify-praxis-performance.mjs",
    "campaign:veil:certification": "pnpm --filter @scry/executor campaign:veil:certification",
    "campaign:veil:adversarial": "pnpm --filter @scry/executor campaign:veil:adversarial",
    "campaign:veil:public-apps": "pnpm --filter @scry/executor campaign:veil:public-apps",
    "campaign:veil:production-e2e": "pnpm --filter @scry/executor campaign:veil:production-e2e",
    "campaign:veil:release-scope": "pnpm --filter @scry/executor campaign:veil:release-scope",
    "campaign:veil:worker-crash": "pnpm --filter @scry/api campaign:veil:worker-crash",
    "verify:veil-change-gate": "node scripts/verify-veil-change-gate.mjs",
    "verify:veil-performance": "node scripts/verify-veil-performance.mjs",
    "verify:dashboard-read-only": "pnpm --filter @scry/web build && node scripts/verify-dashboard-read-only.mjs",
    "schema:fingerprint": "node scripts/schema-fingerprint.mjs",
    "verify:release-fingerprint": "node scripts/verify-release-fingerprint.mjs",
    "verify:production-operations": "node scripts/verify-production-operations.mjs",
    "verify:deployment-preflight": "node scripts/verify-deployment-preflight.mjs",
    "verify:deployment-tiers": "node scripts/verify-deployment-tiers.mjs",
    "verify:production-recovery": "sh scripts/qualify-production-recovery.sh",
    "evidence:refresh:veil": "node scripts/refresh-veil-release-evidence.mjs",
    "verify:veil-release-evidence": "node scripts/verify-veil-release-evidence.mjs",
    "verify:veil-manifest-stability": "node scripts/verify-veil-manifest-stability.mjs",
    "verify:veil-release-transition": "node scripts/verify-veil-release-transition.mjs",
    "verify:veil-db-restore": "bash scripts/veil-db-snapshot-restore.sh",
    "verify:veil-rollback:docker": "bash scripts/qualify-veil-cross-schema-rollback.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "analyze:decomposition": "node scripts/analyze-source-structure.mjs",
    "test": "pnpm --recursive test",
    "typecheck": "pnpm --recursive typecheck",
    "verify:assurance-foundation": "pnpm --filter @scry/assurance test:foundation"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "vitest": "^4.0.15"
  }
}
