{
  "name": "scry",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "db:migrate": "pnpm --filter @scry/api db:migrate",
    "db:activate": "pnpm --filter @scry/api db:activate",
    "dev:api": "pnpm --filter @scry/api dev",
    "dev:mcp": "pnpm --filter @scry/mcp start:http",
    "dev:web": "pnpm --filter @scry/web dev",
    "docker:up": "node scripts/docker-up.mjs",
    "docker:dev": "docker compose up --build --watch",
    "docker:watch": "docker compose watch --no-up",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f --tail=200",
    "docker:reset": "docker compose down --volumes --remove-orphans",
    "format": "prettier --write .",
    "format:check": "node scripts/verify-format.mjs",
    "typecheck": "pnpm --filter @scry/contracts typecheck && pnpm --filter @scry/veil typecheck && pnpm --filter @scry/chronicle typecheck && pnpm --filter @scry/praxis typecheck && pnpm --filter @scry/api typecheck && pnpm --filter @scry/mcp typecheck && pnpm --filter @scry/web typecheck",
    "test": "pnpm --filter @scry/contracts test && pnpm --filter @scry/veil test && pnpm --filter @scry/chronicle test && pnpm --filter @scry/praxis test && pnpm --filter @scry/api test && pnpm --filter @scry/mcp test && pnpm --filter @scry/web test",
    "build": "pnpm --filter @scry/web build",
    "verify:playwright": "node scripts/verify-playwright-version.mjs",
    "verify:baseline-topology": "node scripts/verify-baseline-topology.mjs",
    "verify:boundary-ownership": "node --test scripts/test/boundary-ownership.test.mjs && node scripts/verify-boundary-ownership.mjs",
    "verify:boundary-runtime": "node scripts/verify-boundary-runtime.mjs",
    "verify:workflow-manifests": "node scripts/verify-workflow-manifests.mjs",
    "verify:deployment-preflight": "node scripts/verify-deployment-preflight.mjs",
    "verify:deployment-tiers": "node scripts/verify-deployment-tiers.mjs",
    "verify:production-operations": "node scripts/verify-production-operations.mjs",
    "verify:production-recovery": "sh scripts/qualify-production-recovery.sh",
    "verify:deployment-runtime": "node scripts/verify-deployment-runtime.mjs",
    "verify:docker-publish-workflow": "node scripts/verify-docker-publish-workflow.mjs",
    "verify:server-deployment": "node scripts/verify-server-deployment.mjs",
    "verify": "pnpm format:check && pnpm typecheck && pnpm test && pnpm build && pnpm verify:playwright && pnpm verify:baseline-topology && pnpm verify:boundary-ownership && pnpm verify:workflow-manifests && pnpm verify:docker-publish-workflow && pnpm verify:server-deployment"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "vitest": "^4.0.15"
  }
}
