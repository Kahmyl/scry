{
  "protocolVersion": "1",
  "name": "Signup validation",
  "objective": "Verify signup validation and successful account creation.",
  "preconditions": [
    "The staging application is available.",
    "The supplied email address is not registered."
  ],
  "allowedOrigins": ["https://staging.example.com"],
  "budgets": {
    "maxActions": 20,
    "maxDurationMs": 60000,
    "maxNavigations": 3
  },
  "steps": [
    {
      "id": "open-signup",
      "title": "Open the signup page",
      "action": {
        "type": "navigate",
        "url": "/signup"
      },
      "assertions": [
        {
          "type": "visible",
          "target": {
            "strategy": "role",
            "role": "heading",
            "name": "Create account"
          }
        }
      ],
      "evidence": ["screenshot"]
    },
    {
      "id": "enter-email",
      "title": "Enter the test email",
      "action": {
        "type": "fill",
        "target": {
          "strategy": "label",
          "value": "Email"
        },
        "secretRef": "11111111-1111-4111-8111-111111111111"
      }
    },
    {
      "id": "submit-signup",
      "title": "Submit the signup form",
      "action": {
        "type": "click",
        "target": {
          "strategy": "role",
          "role": "button",
          "name": "Create account"
        }
      },
      "assertions": [
        {
          "type": "url",
          "expected": "/onboarding",
          "match": "path"
        }
      ],
      "evidence": ["screenshot", "network"]
    }
  ]
}
