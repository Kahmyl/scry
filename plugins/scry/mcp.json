{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "scry": {
      "type": "streamable-http",
      "url": "https://scry.giize.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": { "mode": "dcr" },
            "baseScopes": ["scry:testing"],
            "defaultScopes": ["scry:testing"],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
