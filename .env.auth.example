# Required: public hostname and durable application secrets.
SCRY_DOMAIN=scry.example.com
POSTGRES_PASSWORD=replace-me
SCRY_SERVICE_TOKEN=replace-me
SCRY_CREDENTIAL_ENCRYPTION_KEY=replace-me
VEIL_ADMISSION_KEY=replace-with-at-least-32-random-bytes

# Artifact storage: local | s3 | cloudinary | gcs. Only configure the selected provider.
ARTIFACT_STORAGE_PROVIDER=local
ARTIFACT_ROOT=artifacts/runs
ARTIFACT_STORAGE_PREFIX=

# Generic S3-compatible storage. Works with AWS S3, RustFS, Supabase Storage,
# Cloudflare R2, Backblaze B2, and compatible providers.
ARTIFACT_S3_BUCKET=
ARTIFACT_S3_REGION=
ARTIFACT_S3_ENDPOINT=
ARTIFACT_S3_ACCESS_KEY_ID=
ARTIFACT_S3_SECRET_ACCESS_KEY=
ARTIFACT_S3_SESSION_TOKEN=
ARTIFACT_S3_FORCE_PATH_STYLE=false

# Cloudinary stores evidence as authenticated raw assets.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Cloud Storage. Supply exactly one credential source.
ARTIFACT_GCS_BUCKET=
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Required: authenticated Supabase deployment.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-me

# Optional: pin a published release instead of latest.
SCRY_IMAGE_TAG=latest
SCRY_WORKER_CONCURRENCY=1
