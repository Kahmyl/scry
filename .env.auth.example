# Required: public hostname and durable application secrets.
SCRY_DOMAIN=scry.example.com
POSTGRES_PASSWORD=replace-me
SCRY_SERVICE_TOKEN=replace-me
SCRY_CREDENTIAL_ENCRYPTION_KEY=replace-me

# Required: authenticated Supabase deployment.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-me

# Optional: pin a published release instead of latest.
SCRY_IMAGE_TAG=latest
SCRY_WORKER_CONCURRENCY=1
